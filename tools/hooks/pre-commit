#!/usr/bin/env bash
# Versioned pre-commit hook. Enabled with:
#     git config core.hooksPath tools/hooks
#
# Lives in the tree rather than .git/hooks so it survives a fresh clone —
# .git/hooks is not versioned, so a hook that only exists there protects exactly
# one working copy and silently protects nothing on every other machine.

set -uo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HOOK_DIR/../check_ddp_drift.sh"
