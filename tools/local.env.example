# Copy to tools/local.env (git-ignored) and fill in the paths on your machine.
# tools/release_build.sh reads it before anything else. WSL paths shown.

# Godot 4.6.3 (stable) console binary, with Android export templates installed.
GODOT="/mnt/c/Users/<you>/Godot/Godot_v4.6.3-stable_win64_console.exe"

# Android SDK with build-tools 37.0.0.
ANDROID_SDK="/mnt/c/Users/<you>/AppData/Local/Android/Sdk"

# bundletool jar, only needed for the public .aab checks.
BUNDLETOOL="/mnt/c/Users/<you>/tools/bundletool-all-1.18.3.jar"

# Java used for apksigner and bundletool (Android Studio's bundled JBR works).
JAVA="/mnt/c/Program Files/Android/Android Studio/jbr/bin/java.exe"

# A file OUTSIDE the repo that exports your own release keystore:
#   GODOT_ANDROID_KEYSTORE_RELEASE_PATH=...
#   GODOT_ANDROID_KEYSTORE_RELEASE_USER=...
#   GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=...
PVJ_KEYS_ENV="/mnt/c/Users/<you>/keystores/my-release.env"
