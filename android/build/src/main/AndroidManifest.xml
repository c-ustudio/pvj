<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto" >

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Live camera source (CameraServer). Optional so the app still installs on
         camera-less devices; the CAMERA permission is requested at runtime. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:label="@string/godot_project_name_string"
        android:allowBackup="false"
        android:icon="@mipmap/icon"
        android:appCategory="game"
        android:isGame="true"
        android:hasFragileUserData="false"
        android:requestLegacyExternalStorage="false"
        tools:ignore="GoogleAppIndexingWarning" >

        <!-- PocketVJ dual-screen Presentation plugin (Session 3b) -->
        <meta-data
            android:name="org.godotengine.plugin.v2.PocketVJPresentation"
            android:value="com.pocketvj.PresentationPlugin" />

        <!-- VJMIX storage (both tiers): SAF folder/import/image access, the
             Play-compliant replacement for MANAGE_EXTERNAL_STORAGE. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.VJMIXStorage"
            android:value="com.pocketvj.StoragePlugin" />

        <!-- The video-link and tracking plugins are PRO-ONLY: their
             registrations live in src/pro/AndroidManifest.xml (the Gradle
             `pro` tier), next to their classes. -->

        <!-- ⚠️ NO FileProvider IS DECLARED HERE ON PURPOSE. godot-lib's own
             AndroidManifest already registers one, with exactly the authority
             this app would have used (${applicationId}.fileprovider), and its
             godot_provider_paths.xml already maps <external-path path="."> —
             which covers /storage/emulated/0/PocketVJ/recordings.
             Adding a second <provider> of the same android:name FAILS THE BUILD
             at manifest merge ("meta-data#android.support.FILE_PROVIDER_PATHS
             ... is also present at [godot-lib...aar]"), and the merger's
             suggested tools:replace would point Godot's own provider at our
             paths file and break its file sharing. Recording playback reuses
             Godot's provider instead — see handOff() in PresentationPlugin.kt. -->


        <profileable
            android:shell="true"
            android:enabled="true"
            tools:targetApi="29" />

        <activity
            android:name=".GodotApp"
            android:theme="@style/GodotAppSplashTheme"
            android:launchMode="singleInstancePerTask"
            android:excludeFromRecents="false"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:resizeableActivity="false"
            tools:ignore="UnusedAttribute" />
        <activity-alias
            android:name=".GodotAppLauncher"
            android:targetActivity=".GodotApp"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
